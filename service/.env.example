# Copy to .env and fill in. .env is gitignored; never commit it.

# The notebook folder on this machine (the one `caderno init` created).
CADERNO_NOTEBOOK=/home/you/caderno

# Two random secrets: openssl rand -hex 32
POSTGRES_PASSWORD=
CADERNO_TOKEN=

# Your user and group ids (`id -u`, `id -g`), so written notes belong to you.
CADERNO_UID=1000
CADERNO_GID=1000

# Embeddings. Any of these works:
#   Ollama on this machine:   EMBED_PROVIDER=ollama  EMBED_URL=http://host.docker.internal:11434  EMBED_MODEL=nomic-embed-text
#   Ollama elsewhere:         EMBED_PROVIDER=ollama  EMBED_URL=http://gpu-box:11434               EMBED_MODEL=qwen3-embedding:0.6b
#   OpenAI-compatible (vLLM, LM Studio, llama.cpp server, OpenAI itself):
#                             EMBED_PROVIDER=openai  EMBED_URL=http://host:8000/v1  EMBED_MODEL=<model id>  EMBED_API_KEY=<if needed>
#   No model yet (word matching only, for trying it out): EMBED_PROVIDER=fake
EMBED_PROVIDER=ollama
EMBED_URL=http://host.docker.internal:11434
EMBED_MODEL=nomic-embed-text
EMBED_API_KEY=

# Where it listens. 127.0.0.1 = this machine only.
CADERNO_BIND=127.0.0.1
CADERNO_PORT=8420

# How often to pick up notes edited by hand or pulled by sync (seconds).
REINDEX_SECONDS=300
# How similar a new note must be to an existing one before `remember` asks
# you to update instead. Tune it for your model (0 to 1).
DUPLICATE_THRESHOLD=0.82
